<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-6 offset-3">

<form action="/login" method="POST"
      class="needs-validation" novalidate>

    <div class="mb-3">
        <label for="username" class="form-label">
            Username
        </label>

        <input
            type="text"
            id="username"
            name="username"
            class="form-control"
            placeholder="Enter username"
            required>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">
            Password
        </label>

        <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="Enter Password"
            required>
    </div>

    <button class="btn btn-dark my-btn" type="submit">
        Login
    </button>

</form>

    </div>
</div>