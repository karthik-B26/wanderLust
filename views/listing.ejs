<% layout("/layouts/boilerplate") %>
<body>
<h1>All the listings</h1>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let listing of result) { %>
    <a href="/listings/<%=listing.id%>" class="content">
        <div class="card"  >
        <img src="<%=listing.image.url%>" class="card-img-top" alt="..." style="height: 18rem;">
        <div class="card-img-overlay">.</div>
            <div class="card-body ">
            <p class="card-text"><%=listing.title%></p>
            <p class="card-text">&#x20B9;<%=  listing.price.toLocaleString("en-IN") %></p>
        </div>
    </div>
    </a>
     
    <% } %>
</div>
   



</body>