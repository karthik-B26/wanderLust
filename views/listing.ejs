<% layout("/layouts/boilerplate") %>
<body>
<h1>All the listings</h1>
<div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 gy-0">
    <% for (let listing of result) { %>
    <a href="/listings/<%=listing.id%>" class="content">
        <div class="card"  >
        <img src="<%=listing.image.url%>" class="card-img-top" alt="..." >
        <div class="card-img-overlay">.</div>
            <div class="card-body ">
           <b ><p class="card-text"><%=listing.title%></b><br><span class="boldd">&#x20B9;<%=  listing.price.toLocaleString("en-IN") %>/ night</span></p>
        </div>
    </div>
    </a>
     
    <% } %>
</div>
   



</body>