<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br>

    
   <form action="/listings/<%= result.id %>?_method=PUT" method="POST">

    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
            id="title"
            type="text"
            value="<%= result.title %>"
            name="Listing[title]"
            class="form-control">
    </div>

    <div class="mb-3">
        <label for="desc" class="form-label">Description</label>
        <textarea
            id="desc"
            name="Listing[description]"
            class="form-control"><%= result.description %></textarea>
    </div>
    <div class="row">
        <div class="col-4 mb-3">
        <label for="price" class="form-label">Price</label>
        <input
            id="price"
            type="number"
            value="<%= result.price %>"
            name="Listing[price]"
            class="form-control">
    </div>

    <div class="col-8 cmb-3">
        <label for="location" class="form-label">Location</label>
        <input
            id="location"
            type="text"
            value="<%= result.location %>"
            name="Listing[location]"
            class="form-control">
    </div>
    </div>
    

    <div class="mb-3">
        <label for="country" class="form-label">Country</label>
        <input
            id="country"
            type="text"
            value="<%= result.country %>"
            name="Listing[country]"
            class="form-control">
    </div>

    <button class="btn btn-dark my-btn" type="submit">Done</button>

</form>
</div>
</div>
</body>
