<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
        <h1> Listing Details </h1>
        <br>
         <div class="card">
            <img src="<%=result.image.url%>" class="card-img-top card-img-top-1" alt="...">
            <div class="card-body">
               <b><p class="card-text"><%=result.title %></p></b>
                <p class="card-text"><%=result.description %></p>
                <p class="card-text">&#x20B9;<%= result.price.toLocaleString("en-IN") %></p>
                <p class="card-text"><%=result.location %></p>
                <p><%=result.country %></p>
            </div>
            
            <div class="d-flex gap-2">
                <form class="flex-fill" method="get" action="/listings/<%= result.id %>/edit">
                    <button class="btn my-btn w-100">Edit</button>
                </form>

                <form class="flex-fill" action="/listings/<%= result.id %>?_method=DELETE" method="POST">
                    <button class="btn btn-dark w-100" type="submit">DELETE</button>
                </form>
            </div>
           
        </div>
        <br>
    </div>
    </div>
    </div>
   
        