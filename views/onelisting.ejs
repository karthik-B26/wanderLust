<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
        <h1> Listing Details </h1>
        <br>
         <div class="card">
            <img src="<%=result.image.url%>" class="card-img-top card-img-top-1" alt="...">
            <div class="card-body">
               <b><p class="card-text"><%=result.title %></p></b>
                <p class="card-text"><%=result.description %></p>
                <p class="card-text">&#x20B9;<%= result.price.toLocaleString("en-IN") %></p>
                <p class="card-text"><%=result.location %></p>
                <p><%=result.country %></p>
            </div>
            
            <div class="d-flex gap-2">
                <form class="flex-fill" method="get" action="/listings/<%= result.id %>/edit">
                    <button class="btn my-btn w-100">Edit</button>
                </form>

                <form class="flex-fill" action="/listings/<%= result.id %>?_method=DELETE" method="POST">
                    <button class="btn btn-outline-dark w-100" type="submit">DELETE</button>
                </form>
            </div>
           
        </div>
        <br>
        <form method="POST" action="/listings/<%=result.id%>/reviews" class="mb-3 needs-validation" novalidate>
            <div class="mb-3">
                    <label for="range2" class="form-label">Rate us </label>
                <input type="range" class="form-range" min="1" max="5" id="range2" name="review[rating]" required>
                <div class="invalid-feedback" >Please enter the stars </div>
            </div>
            <div class="mb-3">
                <label class="form-label"> Lave us a comment</label>
                <textarea class="form-control" cols="30" rows="5" name="review[comment]"></textarea>
            </div>
            <button type="submit" class="btn btn-outline-dark">Submit Review</button>
        </form> 
<p>All reviews</p>

<div class="row g-4 mb-3">

    <% for (let review of result.reviews) { %>

        <div class="col-12 col-md-6">
    <div class="card reviewb h-100 position-relative">

        <div class="card-body">
            <h5 class="card-title">John Doe</h5>

            <p class="card-text">
                Rating: <%= review.rating %> ⭐
            </p>

            <p class="card-text">
                <%= review.comment %>
            </p>
        </div>
        <form  method="POST" action="/listings/<%=result.id%>/reviews/<%=review.id%>?_method=DELETE"  class="m-3"><button class="btn btn-dark w-50%" type="submit" >Delete</button></form>
       

    </div>
</div>
    <% } %>

</div>
        
    </div>
    </div>
    </div>
   